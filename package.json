{
  "name": "subsidea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "wrangler dev",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "crawl:data": "py -3 scripts/crawler.py",
    "validate:data": "node scripts/validate-content.mjs",
    "audit:freshness": "node scripts/audit-freshness.mjs",
    "audit:indexability": "node scripts/audit-indexability.mjs",
    "audit:planner": "node scripts/audit-planner.mjs",
    "test:content": "node --test tests/*.test.mjs",
    "audit:quality": "node scripts/audit-quality.mjs --strict"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.2"
    }
  }
}
